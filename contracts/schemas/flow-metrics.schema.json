{
  "$defs": {
    "FlowMetricItem": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "evidence": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "FlowMetricItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "tenant": {
      "title": "Tenant",
      "type": "string"
    },
    "commit_sha": {
      "title": "Commit Sha",
      "type": "string"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/FlowMetricItem"
      },
      "title": "Metrics",
      "type": "array"
    }
  },
  "required": [
    "tenant",
    "commit_sha",
    "metrics"
  ],
  "title": "FlowMetricsReport",
  "type": "object"
}
